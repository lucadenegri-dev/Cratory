# Database (default: SQLite file in backend/data/)
DATABASE_URL=sqlite:///./data/djassistant.db

# CORS origin del frontend
FRONTEND_ORIGIN=http://localhost:3000

# --- Integrazioni future (MVP 2+), lasciare vuoto per ora ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Nota: Spotify non accetta piu' http://localhost — usare il loopback 127.0.0.1
# (stesso valore da inserire come Redirect URI nell'app su developer.spotify.com)
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/spotify/callback
# MusicBrainz: nessuna API key, ma serve uno User-Agent identificativo con un contatto REALE
# (formato: NomeApp/versione (tua-email)). Vuoto = MusicBrainz disattivato.
MUSICBRAINZ_USER_AGENT=
# Enrichment musicale (BPM/key/mood/energia). Vuoti = provider disattivo.
GETSONGBPM_API_KEY=
# Last.fm (gratuito): genere + mood dai tag (enrichment feature) e similarita' per il Discovery.
LASTFM_API_KEY=
AI_API_KEY=
AI_MODEL=
# Modello di default: claude-opus-4-8 (override con AI_MODEL).
# AI_MODEL_CREATIVE (opzionale): modello usato SOLO nella modalità "creative" del Set
# Builder. Così puoi tenere AI_MODEL economico (es. Haiku) e un modello più capace solo
# quando vuoi il "co-DJ". Vuoto = creative usa lo stesso modello di AI_MODEL.
AI_MODEL_CREATIVE=
# Effort dell'LLM (low|medium|high|max) e thinking (adaptive|disabled).
# Tenere bassi entrambi: con effort alto + thinking esteso la generazione è lentissima.
AI_EFFORT=low
AI_THINKING=adaptive
