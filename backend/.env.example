# Database locale canonico. I path relativi SQLite vengono risolti rispetto a backend/.
DATABASE_URL=sqlite:///data/djassistant.db

# CORS origin del frontend
FRONTEND_ORIGIN=http://localhost:3000

# --- Integrazioni future (MVP 2+), lasciare vuoto per ora ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Nota: Spotify non accetta piu' http://localhost — usare il loopback 127.0.0.1
# (stesso valore da inserire come Redirect URI nell'app su developer.spotify.com)
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/spotify/callback
AI_API_KEY=
# Modello AI. Vuoto = claude-opus-4-8 (default). Per il modello economico Haiku 4.5
# (input $1 / output $5 per 1M token):
#   AI_MODEL=claude-haiku-4-5
AI_MODEL=
# Effort dell'LLM (low|medium|high|max) e thinking (adaptive|disabled).
# Tenere bassi entrambi: con effort alto + thinking esteso la generazione è lentissima.
# NB: effort/adaptive valgono solo per Opus 4.6+/Sonnet 4.6/Fable; per i modelli
# economici (Haiku 4.5) vengono ignorati automaticamente (li rifiuterebbero con un 400).
AI_EFFORT=low
AI_THINKING=adaptive
# Discogs: profondita' per il Discovery (crate digging per genere/stile ed etichetta).
# Funziona ANCHE senza token (rate ~25/min). Token (gratuito) -> ~60/min E copertine:
# https://www.discogs.com/settings/developers  (Generate token)
DISCOGS_TOKEN=

# slskd (Soulseek download) — lascia vuoto per disattivare
SLSKD_URL=
SLSKD_API_KEY=
SLSKD_DOWNLOAD_DIR=

# Libreria canonica su disco (disk-first): la cartella organizzata che Cratory
# indicizza da Impostazioni -> "Libreria (disco)". Vuoto = indicizzazione disattiva.
LIBRARY_ROOT=

# Archivio delle tracce scartate (ARCHIVE_DIR di DJPlayer). Vuoto = disattivo.
ARCHIVE_ROOT=

# --- Organize (ex Sortory) --------------------------------------------------
# Sezione /organize: pulizia tag, duplicati, piano e apply sui file su disco.
# Dalla fusione F2 non c'è più un DB né un prefisso separati: queste chiavi
# vivono nella stessa Settings di Cratory. Il token Discogs è quello unico
# dichiarato più sopra (DISCOGS_TOKEN), non ce n'è uno dedicato.

# MusicBrainz non richiede chiave, ma esige uno User-Agent identificabile.
MUSICBRAINZ_USER_AGENT=Cratory-Organize/0.1 (+http://localhost)

# AcoustID: fingerprint acustico → AudioFile.mbid.
# Serve ANCHE il binario fpcalc (Chromaprint): `brew install chromaprint`.
ACOUSTID_API_KEY=

# Chiave Anthropic per le feature AI di Organize ("Risolvi con AI", revisione
# generi). Chiave DISTINTA da AI_API_KEY qui sopra, che alimenta l'AI di Cratory:
# app/organize/services/ai_tags.py legge direttamente os.environ["ANTHROPIC_API_KEY"],
# popolato da load_dotenv() in app/main.py — non passa da pydantic-settings.
# Senza, i due bottoni AI di Organize mostrano un avviso e non chiamano l'AI.
ANTHROPIC_API_KEY=
