# DjOrganizer backend config — copia in `.env` (gitignored) e compila.
# Caricato all'avvio da app/main.py (python-dotenv) in os.environ.

# DB SQLite locale (pydantic-settings, prefix DJORG_)
DJORG_DATABASE_URL=sqlite:///./data/djorganizer.db

# Chiave Anthropic per la feature "Risolvi con AI" (modello Claude Haiku).
# Senza, il bottone mostra un avviso e non chiama l'AI. La trovi su
# https://console.anthropic.com/ → API Keys. NON ha il prefisso DJORG_.
ANTHROPIC_API_KEY=

# --- Provider di metadati testuali (endpoint "Suggerisci da provider") ---
# Riempiono i suggerimenti sulle issue aperte con precedenza
# manuale > tag pulito > provider (MusicBrainz/Discogs) > AI.

# MusicBrainz non richiede chiave, ma esige uno User-Agent identificabile.
# Metti un contatto reale (email o URL) al posto del placeholder: è buona
# educazione e riduce il rischio di rate limit. Il default sotto funziona
# ma è generico.
DJORG_MUSICBRAINZ_USER_AGENT=DjOrganizer/0.1 (+http://localhost)

# Discogs: riempie label/stile/anno mancanti dopo MusicBrainz. Funziona ANCHE
# senza token (~25/min); con token (gratuito) sale a ~60/min.
# Genera il token su https://www.discogs.com/settings/developers
DJORG_DISCOGS_TOKEN=

# AcoustID: fingerprint acustico → AudioFile.mbid (identità certa per MusicBrainz).
# Serve ANCHE il binario fpcalc (Chromaprint): `brew install chromaprint`.
# Senza chiave o senza fpcalc, l'endpoint /api/fingerprint degrada pulito
# (configured: false) e il bottone "Identifica ora" resta disabilitato.
# Chiave gratuita su https://acoustid.org/new-application
DJORG_ACOUSTID_API_KEY=
