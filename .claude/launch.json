      "runtimeExecutable": "C:\\Develop\\DJAssistant\\frontend\\dev.cmd",
      "runtimeArgs": [],
      "cwd": "frontend",
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "backend-win",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--port", "8000", "--app-dir", "backend"],
      "port": 8000,
      "autoPort": false
    }
  ]
